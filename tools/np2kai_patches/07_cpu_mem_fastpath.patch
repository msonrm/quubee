+/* ---- QuuBee patch 07: 物理メモリ fast path (inline) ----
+ * CPU からのアクセスの大半は conventional RAM (< 0xA0000/0xA4000) か拡張メモリ。RAM の区間だけを
+ * 呼び出し元へインライン展開し、それ以外 (VRAM/ROM/15-16MB ホール/9821 領域/MMIO) は out-of-line の
+ * *_slow (本家 memp_*_fast が登録表で「直アクセス不可」と判定したときに呼ぶのと同じ関数) へ落とす。
+ * 拡張メモリの窓は固定の 2 つ:
+ *   [USE_HIMEM, CPU_EXTLIMIT16)  … 1MB 強〜最大 15MB
+ *   [0x1000000, CPU_EXTLIMIT)    … 16MB〜 (DOS/4GW は 32MB 機だと最大連続ブロックが 16MB 以上に
+ *                                   取れるため、ここにコードが載る。Suika3 は命令フェッチのほぼ全部)
+ * 本家の memp_mmio_map_reset が既定で登録する範囲はちょうどこの窓の外側なので、窓の中は本家の
+ * memp_*_fast でも直アクセスになる = 意味論は同一。窓の中に MMIO が登録された場合は cpumem.c の
+ * 安全装置が窓を空にし、全部 *_slow へ回る。登録表を inline で引く版も試したが、
+ * こちらが Suika3 で 3%・Ray で 1% 速く wasm も 130KB 小さい (2026-09-27 実測)。
+ * 境界 (read=CPU_MEMREADMAX, write=CPU_MEMWRITEMAX, 16/32bit は -1/-3)・A20 マスク・write8 の 0x457
+ * (IDE ワークアラウンド) は本家 memp_*_fast と同一。拡張メモリの 16/32bit は 32KB 境界でもバンク
+ * 切替が無いため、窓の中では直ロードと本家 (境界跨ぎは *_slow でバイト合成) は同値。
+ * 窓の上限 qb_fastwin_lim{1,2}[k] は cpumem.c が memp_mmio_map_reset (拡張メモリ量の設定直後に
+ * 本家が呼ぶ) で幅別に引き算済みで張る。拡張メモリが無ければ 0 = 空の窓。 */
+#include "cpumem.h"
+
+#define QB_FASTWIN(m, k) \
+	((m) >= USE_HIMEM && \
+	 ((m) < qb_fastwin_lim1[k] || ((m) >= 0x01000000 && (m) < qb_fastwin_lim2[k])))
+
+STATIC_INLINE REG8 qb_phys_read8(UINT32 address) {
+	UINT32 madr;
+	if (address < CPU_MEMREADMAX)
+		return mem[address];
+	madr = address & CPU_ADRSMASK;
+	if (QB_FASTWIN(madr, 0))
+		return CPU_EXTMEMBASE[madr];
+	return memp_read8_slow(address);
+}
+STATIC_INLINE REG16 qb_phys_read16(UINT32 address) {
+	UINT32 madr;
+	if (address < (CPU_MEMREADMAX - 1))
+		return (REG16)(LOADINTELWORD(mem + address));
+	madr = address & CPU_ADRSMASK;
+	if (QB_FASTWIN(madr, 1))
+		return (REG16)(LOADINTELWORD(CPU_EXTMEMBASE + madr));
+	return memp_read16_slow(address);
+}
+STATIC_INLINE UINT32 qb_phys_read32(UINT32 address) {
+	UINT32 madr;
+	if (address < (CPU_MEMREADMAX - 3))
+		return LOADINTELDWORD(mem + address);
+	madr = address & CPU_ADRSMASK;
+	if (QB_FASTWIN(madr, 3))
+		return LOADINTELDWORD(CPU_EXTMEMBASE + madr);
+	return memp_read32_slow(address);
+}
+STATIC_INLINE void qb_phys_write8(UINT32 address, REG8 value) {
+	UINT32 madr;
+	if (address == 0x0457)	/* IDE データ破壊回避 (本家 memp_write8_fast と同一) */
+		return;
+	if (address < CPU_MEMWRITEMAX) {
+		mem[address] = (UINT8)value;
+		return;
+	}
+	madr = address & CPU_ADRSMASK;
+	if (QB_FASTWIN(madr, 0)) {
+		CPU_EXTMEMBASE[madr] = (UINT8)value;
+		return;
+	}
+	memp_write8_slow(address, value);
+}
+STATIC_INLINE void qb_phys_write16(UINT32 address, REG16 value) {
+	UINT32 madr;
+	if (address < (CPU_MEMWRITEMAX - 1)) {
+		STOREINTELWORD(mem + address, value);
+		return;
+	}
+	madr = address & CPU_ADRSMASK;
+	if (QB_FASTWIN(madr, 1)) {
+		STOREINTELWORD(CPU_EXTMEMBASE + madr, value);
+		return;
+	}
+	memp_write16_slow(address, value);
+}
+STATIC_INLINE void qb_phys_write32(UINT32 address, UINT32 value) {
+	UINT32 madr;
+	if (address < (CPU_MEMWRITEMAX - 3)) {
+		STOREINTELDWORD(mem + address, value);
+		return;
+	}
+	madr = address & CPU_ADRSMASK;
+	if (QB_FASTWIN(madr, 3)) {
+		STOREINTELDWORD(CPU_EXTMEMBASE + madr, value);
+		return;
+	}
+	memp_write32_slow(address, value);
+}
+STATIC_INLINE PF_UINT8 qb_phys_read8_codefetch(UINT32 address) {
+	UINT32 madr;
+	if (address < CPU_MEMREADMAX)
+		return mem[address];
+	madr = address & CPU_ADRSMASK;
+	if (QB_FASTWIN(madr, 0))
+		return CPU_EXTMEMBASE[madr];
+	return memp_read8_codefetch_slow(address);
+}
+STATIC_INLINE PF_UINT16 qb_phys_read16_codefetch(UINT32 address) {
+	UINT32 madr;
+	if (address < (CPU_MEMREADMAX - 1))
+		return (PF_UINT16)(LOADINTELWORD(mem + address));
+	madr = address & CPU_ADRSMASK;
+	if (QB_FASTWIN(madr, 1))
+		return (PF_UINT16)(LOADINTELWORD(CPU_EXTMEMBASE + madr));
+	return memp_read16_codefetch_slow(address);
+}
+STATIC_INLINE PF_UINT32 qb_phys_read32_codefetch(UINT32 address) {
+	UINT32 madr;
+	if (address < (CPU_MEMREADMAX - 3))
+		return LOADINTELDWORD(mem + address);
+	madr = address & CPU_ADRSMASK;
+	if (QB_FASTWIN(madr, 3))
+		return LOADINTELDWORD(CPU_EXTMEMBASE + madr);
+	return memp_read32_codefetch_slow(address);
+}
