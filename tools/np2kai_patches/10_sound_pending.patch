+/* QuuBee patch 10: ステートセーブ用。合成済みで未再生のサンプル (buffer..ptr) を取り出す / 戻す。
+ * セーブの瞬間に鳴りかけていた音を、ロード後にそのまま続けて鳴らすため (statsave のロードは
+ * sound_reset でこれを捨てるので、ロード後に sound_pending_set で差し戻す)。 */
+UINT sound_pending_get(SINT32 *dst, UINT maxsamples) {
+
+	UINT	n;
+
+	if (sndstream.buffer == NULL) {
+		return 0;
+	}
+	n = (UINT)((sndstream.ptr - sndstream.buffer) / 2);
+	if (dst) {
+		CopyMemory(dst, sndstream.buffer, MIN(n, maxsamples) * 2 * sizeof(SINT32));
+	}
+	return n;
+}
+
+void sound_pending_set(const SINT32 *src, UINT samples) {
+
+	if (sndstream.buffer == NULL) {
+		return;
+	}
+	SNDCSEC_ENTER;
+	samples = MIN(samples, sndstream.samples + sndstream.reserve);
+	CopyMemory(sndstream.buffer, src, samples * 2 * sizeof(SINT32));
+	sndstream.ptr = sndstream.buffer + (samples * 2);
+	sndstream.remain = sndstream.samples + sndstream.reserve - samples;
+	SNDCSEC_LEAVE;
+}
