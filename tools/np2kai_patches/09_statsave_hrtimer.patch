diff --git a/io/upd4990.c b/io/upd4990.c
index c8f48f0..d300139 100755
--- a/io/upd4990.c
+++ b/io/upd4990.c
@@ -99,16 +99,15 @@ static void IOOUTCALL upd4990_o20(UINT port, REG8 dat) {
 static void upd4990_hrtimer_setinterval(int absolute);
 
 void upd4990_hrtimer_proc(NEVENTITEM item) {
-	static UINT32 divcounter = 0;
-	static UINT32 divcounter32 = 0;
-	divcounter++;
-	if(divcounter >= 64 / uPD4990HRT.hrtimerdiv){ // 64 -> hrtimerdiv
+	/* QuuBee patch 09: 分周カウンタは uPD4990HRT へ (statsave に入れるため。旧 関数内 static) */
+	uPD4990HRT.divcounter++;
+	if(uPD4990HRT.divcounter >= 64 / uPD4990HRT.hrtimerdiv){ // 64 -> hrtimerdiv
 		pic_setirq(15);
-		divcounter = 0;
+		uPD4990HRT.divcounter = 0;
 	}
 	if(uPD4990HRT.hrtimerclock32){
-		divcounter32++;
-		if(divcounter32 >= 2){ // 64 -> 32
+		uPD4990HRT.divcounter32++;
+		if(uPD4990HRT.divcounter32 >= 2){ // 64 -> 32
 			UINT32 hrtimertimeuint;
 			
 			hrtimertimeuint = LOADINTELDWORD(mem+0x04F1);
@@ -117,7 +116,7 @@ void upd4990_hrtimer_proc(NEVENTITEM item) {
 				hrtimertimeuint = ((hrtimertimeuint & ~0x3fffff) + 0x400000) & 0xffffff; // 日付変わった
 			}
 			STOREINTELDWORD(mem+0x04F1, hrtimertimeuint); // XXX: 04F4にも書いちゃってるけど差し当たっては問題なさそうなので･･･
-			divcounter32 = 0;
+			uPD4990HRT.divcounter32 = 0;
 		}
 	}
 	upd4990_hrtimer_setinterval(0);
@@ -231,9 +230,14 @@ void uPD4990_bind(void) {
 	iocore_attachout(0x0128, upd4990_o128);
 	iocore_attachinp(0x0128, upd4990_i128);
 
-	uPD4990HRT.hrtimerdiv = 32;
-	uPD4990HRT.hrtimerclock = pccore.baseclock/uPD4990HRT.hrtimerdiv;
-	upd4990_hrtimer_setinterval(1);
+	/* QuuBee patch 09: statsave のロードは EVENT 区画と uPD4990HRT を戻した後でこの bind を呼ぶ。ここで
+	 * 分周比とイベントを張り直すと保存した位相が消え、ロード後の CPU の区切りが変わって FM の書き込み位置が
+	 * ずれる (東方の BGM で実測)。イベントが既に動いていればそのままにする (リセットでは消えた後に来る) */
+	if (!nevent_iswork(NEVENT_HRTIMER)) {
+		uPD4990HRT.hrtimerdiv = 32;
+		uPD4990HRT.hrtimerclock = pccore.baseclock/uPD4990HRT.hrtimerdiv;
+		upd4990_hrtimer_setinterval(1);
+	}
 #endif
 }
 
