@@ -21,6 +21,11 @@ typedef struct {
 	
 	UINT32 clockcounter;
 	UINT32 clockcounter32;
+
+	/* QuuBee patch 09: upd4990_hrtimer_proc の分周カウンタ (旧 関数内 static)。statsave の
+	 * uPD4990HRT (BIN) に入れて、ロード後も IRQ15 と 0x04F1 の刻みの位相をそろえる */
+	UINT32 divcounter;
+	UINT32 divcounter32;
 } _UPD4990HRT, *UPD4990HRT;
 
 
@@ -30,6 +35,7 @@ extern "C" {
 	
 #if defined(SUPPORT_HRTIMER)
 void upd4990_hrtimer_count(void);
+void upd4990_hrtimer_proc(NEVENTITEM item);	/* QuuBee patch 09: statsave の evtproc 用 */
 #endif
 
 void uPD4990_reset(const NP2CFG *pConfig);
